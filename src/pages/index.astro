---
import Layout from '../layouts/Layout.astro'
import { allImages } from '../data/images'
---

<Layout title="Forside">

  <div style="position: relative; min-height: 100vh; overflow: visible; display: flex; align-items: center; justify-content: center;">
    <!-- Waves left -->
    <img
      src="/images/waves_transperent.png"
      alt="" aria-hidden="true"
      style="position: absolute; left: 0; top: calc(20% + 100px); bottom: 0; width: auto; max-width: 50%; height: 80%; object-fit: contain; object-position: top left; opacity: 0.28; pointer-events: none; user-select: none; z-index: 0; mask-image: linear-gradient(to left, transparent 0%, black 40%); -webkit-mask-image: linear-gradient(to left, transparent 0%, black 40%);"
    />

    <!-- Hero content -->
    <div style="position: relative; z-index: 60; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 2rem 1rem; transform: translateY(-400px);">
      <img
        src="/images/firstbloodtexttransparent.png"
        alt="First Blood Tattoo"
        style="width: clamp(260px, 60vw, 680px); height: auto; filter: drop-shadow(0 8px 40px rgba(0,0,0,0.9)); position: relative; z-index: 1; margin-bottom: -14rem; transform: translateX(-30px);"
      />
      <img
        src="/images/logo.png"
        alt=""
        style="width: clamp(140px, 28vw, 300px); height: auto; position: relative; z-index: 2; pointer-events: none;"
      />
      <p style="font-family: 'Teko', sans-serif; font-size: clamp(2.5rem, 9vw, 8rem); letter-spacing: 0.18em; color: #ffffff; line-height: 1; margin-top: -0.25rem; text-shadow: 0 4px 30px rgba(0,0,0,0.8);">TATTOO</p>
      <div style="margin-top: 1.2rem;">
        <p style="font-family: 'Bebas Neue', sans-serif; font-size: 0.85rem; letter-spacing: 0.3em; color: var(--muted);">— Tatoveringsstudio · Sandnes —</p>
        <p style="font-family: 'Cormorant Garamond', serif; font-size: clamp(1rem, 2vw, 1.4rem); font-style: italic; color: #F0EBE0; margin-top: 0.4rem; letter-spacing: 0.05em;">Vi tatoverer. Ingenting annet.</p>
      </div>
    </div>

    <!-- Trond right -->
    <img
      src="/images/trond.png"
      alt="" aria-hidden="true"
      style="position: absolute; right: 0; top: 0; height: 75%; width: auto; object-fit: contain; object-position: top right; opacity: 0.24; pointer-events: none; user-select: none; z-index: 1; mask-image: linear-gradient(to right, transparent 0%, black 40%), linear-gradient(to bottom, black 50%, transparent 100%); mask-composite: intersect; -webkit-mask-image: linear-gradient(to right, transparent 0%, black 40%), linear-gradient(to bottom, black 50%, transparent 100%); -webkit-mask-composite: source-in;"
    />
  </div>

  <!-- Full-width gallery -->
  <div class="columns-2 md:columns-3 lg:columns-5 gap-1 space-y-1 w-full">
    {allImages.map(({ id, src, alt }) => (
      <div class="break-inside-avoid overflow-hidden cursor-pointer" onclick={`window.openLightbox('${id}')`}>
        <img src={src} alt={alt} class="w-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
      </div>
    ))}
  </div>

</Layout>
