---
import { u } from "../lib/url"
import Layout from '../layouts/Layout.astro'
import { allImages } from '../data/images'
---

<Layout title="Forside">

  <!-- Hero: budskap til venstre, Trond til høyre, to tydelige valg.
       Bakgrunnen er samme mønster som i headeren, dempet så teksten får god kontrast. -->
  <div class="hero-bakgrunn" style={`--teppe: url('${u('/images/teppe.avif')}')`}>
  <section class="hero">
    <div class="hero-tekst">
      <p class="hero-etikett">Tatoveringsstudio · Sandnes</p>
      <h1 class="hero-tittel">Vi tatoverer.<br /><span>Ingenting annet.</span></h1>
      <p class="hero-ingress">Godt gammeldags håndverk, tatovert av Trond&nbsp;Kjørkleiv.</p>
      <div class="hero-knapper">
        <a href={u('/galleri')} class="knapp knapp-hoved">Se tatoveringer</a>
        <a href={u('/kontakt')} class="knapp knapp-kant">Ta kontakt</a>
      </div>
    </div>
    <figure class="hero-bilde">
      <img src={u('/images/trond.avif')} alt="Trond Kjørkleiv med solbriller og sigar" width="760" height="956" fetchpriority="high" />
    </figure>
  </section>
  <a href="#arbeider" class="rull-ned" aria-label="Se arbeidene">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
  </a>
  </div>

  <!-- Full-width gallery -->
  <div id="arbeider" class="columns-2 md:columns-3 lg:columns-5 gap-1 space-y-1 w-full">
    {allImages.map(({ id, thumb, alt }) => (
      <button type="button" class="block w-full p-0 border-0 bg-transparent break-inside-avoid overflow-hidden cursor-zoom-in focus-visible:outline-3 focus-visible:outline-offset-[-3px] focus-visible:outline-[var(--knapp)]" aria-label={`Vis større: ${alt}`} onclick={`window.openLightbox('${id}')`}>
        <img src={thumb} alt="" class="block w-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
      </button>
    ))}
  </div>


</Layout>

<style>
  .hero-bakgrunn {
    background-image:
      linear-gradient(to bottom, transparent 70%, #000 100%),
      linear-gradient(to right, rgba(28,28,28,0.88) 0%, rgba(28,28,28,0.92) 10%, #000 35%, #000 60%, rgba(28,28,28,0.92) 90%, rgba(28,28,28,0.88) 100%),
      var(--teppe);
    background-size: cover;
    background-position: center;
    position: relative;
  }

  /* Liten markør nederst som viser at det er mer å se. Bare på store skjermer,
     der heroen fyller hele skjermen. */
  .rull-ned { display: none; }
  @media (min-width: 900px) {
    .rull-ned {
      position: absolute; left: 50%; bottom: 1.25rem; transform: translateX(-50%);
      display: flex; align-items: center; justify-content: center;
      width: 48px; height: 48px; color: #C8BFB0;
    }
    .rull-ned svg { width: 36px; height: 36px; }
    .rull-ned svg { animation: hopp 2.2s ease-in-out infinite; }
    .rull-ned:hover { color: #F0EBE0; }
    .rull-ned:focus-visible { outline: 3px solid #F0EBE0; outline-offset: 3px; }
  }
  @keyframes hopp {
    0%, 100% { transform: translateY(0); opacity: 0.7; }
    50% { transform: translateY(6px); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rull-ned svg { animation: none; }
  }
  /* Galleriet havner under den faste headeren når man hopper dit */
  #arbeider { scroll-margin-top: 6.5rem; }

  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 3.5rem;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
      min-height: calc(100svh - 6.5rem);
      padding: 3rem 2rem;
    }
  }
  .hero-etikett {
    font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
    font-size: 1.125rem;
    letter-spacing: 0.25em;
    color: var(--muted);
  }
  .hero-tittel {
    font-family: var(--font-overskrift);
    font-weight: 900;
    font-size: clamp(3rem, 7.5vw, 6.5rem);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: #F0EBE0;
    margin-top: 0.75rem;
  }
  /* Andre linje mindre: «Vi tatoverer.» er hovedbudskapet, «Ingenting annet.» er punchlinen */
  .hero-tittel span { display: inline-block; margin-top: 0.15em; font-size: 0.55em; letter-spacing: 0.04em; color: var(--accent); }
  .hero-ingress {
    text-wrap: balance;
    font-size: 1.375rem;
    line-height: 1.4;
    color: #C8BFB0;
    margin-top: 1.25rem;
    max-width: 32rem;
  }
  .hero-knapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .knapp {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.7rem 1.6rem 0.5rem;
    font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
    font-size: 1.375rem;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    border-radius: var(--knapp-hjorne);
    transition: background-color 0.15s, color 0.15s;
  }
  .knapp:focus-visible { outline: 3px solid #F0EBE0; outline-offset: 3px; }
  .knapp-hoved { background: var(--knapp); color: var(--knapp-tekst); }
  .knapp-hoved:hover { background: var(--knapp-hover); }
  .knapp-kant { border: 2px solid #F0EBE0; color: #F0EBE0; }
  .knapp-kant:hover { background: #F0EBE0; color: #000; }
  .hero-bilde {
    position: relative;
    margin: 0;
    max-width: 26rem;
    justify-self: center;
    width: 100%;
  }
  .hero-bilde img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }
</style>
