---
import { u } from "../lib/url"
import Layout from '../layouts/Layout.astro'
import { allImages } from '../data/images'
---

<Layout title="Forside">

  <!-- Hero: budskap til venstre, Trond til høyre, to tydelige valg -->
  <section class="hero">
    <div class="hero-tekst">
      <p class="hero-etikett">Tatoveringsstudio · Sandnes</p>
      <h1 class="hero-tittel">Vi tatoverer.<br /><span>Ingenting annet.</span></h1>
      <p class="hero-ingress">Trond Kjørkleiv. Godt gammeldags håndverk av god kvalitet.</p>
      <div class="hero-knapper">
        <a href={u('/galleri')} class="knapp knapp-hoved">Se tatoveringer</a>
        <a href={u('/kontakt')} class="knapp knapp-kant">Ta kontakt</a>
      </div>
    </div>
    <figure class="hero-bilde">
      <img src={u('/images/trond.avif')} alt="Trond Kjørkleiv med solbriller og sigar" width="760" height="956" fetchpriority="high" />
    </figure>
  </section>

  <!-- Full-width gallery -->
  <div class="columns-2 md:columns-3 lg:columns-5 gap-1 space-y-1 w-full">
    {allImages.map(({ id, thumb, alt }) => (
      <div class="break-inside-avoid overflow-hidden cursor-pointer" onclick={`window.openLightbox('${id}')`}>
        <img src={thumb} alt={alt} class="w-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
      </div>
    ))}
  </div>


</Layout>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 3.5rem;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
      min-height: calc(100svh - 6.5rem);
      padding: 3rem 2rem;
    }
  }
  .hero-etikett {
    font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
    font-size: 1.125rem;
    letter-spacing: 0.25em;
    color: var(--muted);
  }
  .hero-tittel {
    font-family: var(--font-overskrift);
    font-weight: 900;
    font-size: clamp(3rem, 7.5vw, 6.5rem);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: #F0EBE0;
    margin-top: 0.75rem;
  }
  .hero-tittel span { color: var(--accent); }
  .hero-ingress {
    font-size: 1.375rem;
    line-height: 1.4;
    color: #C8BFB0;
    margin-top: 1.25rem;
    max-width: 32rem;
  }
  .hero-knapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .knapp {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.7rem 1.6rem 0.5rem;
    font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
    font-size: 1.375rem;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    border-radius: var(--knapp-hjorne);
    transition: background-color 0.15s, color 0.15s;
  }
  .knapp:focus-visible { outline: 3px solid #F0EBE0; outline-offset: 3px; }
  .knapp-hoved { background: var(--knapp); color: var(--knapp-tekst); }
  .knapp-hoved:hover { background: var(--knapp-hover); }
  .knapp-kant { border: 2px solid #F0EBE0; color: #F0EBE0; }
  .knapp-kant:hover { background: #F0EBE0; color: #000; }
  .hero-bilde {
    position: relative;
    margin: 0;
    max-width: 26rem;
    justify-self: center;
    width: calc(100% - 14px); /* plass til den røde rammen */
    margin-right: 14px;
  }
  .hero-bilde::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(14px, 14px);
    border: 2px solid var(--accent);
  }
  .hero-bilde img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }
</style>
