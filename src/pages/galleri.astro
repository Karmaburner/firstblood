---
import Layout from '../layouts/Layout.astro'
import { allImages } from '../data/images'

const alleKategorier = [
  { id: 'black-grey', label: 'Black & Grey' },
  { id: 'color', label: 'Color' },
  { id: 'cover-up', label: 'Cover Up' },
  { id: 'old-school', label: 'Old School' },
  { id: 'japanese', label: 'Japanese' },
  { id: 'neo-traditional', label: 'Neo-Traditional' },
  { id: 'realism', label: 'Realism' },
  { id: 'geometric', label: 'Geometric' },
  { id: 'mandala', label: 'Mandala' },
  { id: 'blackwork', label: 'Blackwork' },
  { id: 'new-school', label: 'New School' },
  { id: 'lettering', label: 'Lettering' },
]
// Vis bare kategorier som har bilder. Får Trond flere stilarter, dukker de opp av seg selv.
const kategorier = [
  { id: 'alle', label: 'Alle', antall: allImages.length },
  ...alleKategorier
    .map((k) => ({ ...k, antall: allImages.filter((b) => b.category === k.id).length }))
    .filter((k) => k.antall > 0),
]
---

<Layout title="Galleri" description="Se tatoveringer fra First Blood Tattoo i Sandnes: farger, black and grey, cover-up og mer.">
  <section class="galleri">
    <header class="galleri-topp">
      <p class="etikett">Galleri</p>
      <h1>Ink work</h1>
    </header>

    <!-- Bokhylle (datamaskin) -->
    <div class="hylle" role="group" aria-label="Velg stilart">
      {kategorier.map(({ id, label, antall }, i) => (
        <button type="button" class:list={['rygg', { aktiv: i === 0 }]} data-filter={id} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="rygg-tekst">{label}</span>
          <span class="rygg-antall">{antall} bilder</span>
        </button>
      ))}
    </div>

    <!-- Knapper (mobil) -->
    <div class="brikker" role="group" aria-label="Velg stilart">
      {kategorier.map(({ id, label, antall }, i) => (
        <button type="button" class="brikke" data-filter={id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {label} <span class="brikke-antall">{antall}</span>
        </button>
      ))}
    </div>

    <p class="antall-vist" role="status" aria-live="polite"></p>

    <div class="rutenett">
      {allImages.map(({ id, thumb, alt, category }) => (
        <button type="button" class="bilde" data-category={category} aria-label={`Vis større: ${alt}`} onclick={`window.openLightbox('${id}')`}>
          <img src={thumb} alt="" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  </section>
</Layout>

<style>
  .galleri { padding: 2.5rem 0 4rem; }
  .galleri-topp, .hylle, .brikker, .antall-vist { margin-inline: 1.25rem; }
  @media (min-width: 768px) {
    .galleri { padding-top: 4rem; }
    .galleri-topp, .hylle, .brikker, .antall-vist { margin-inline: 2rem; }
  }
  .etikett {
    font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
    font-size: 1.125rem; letter-spacing: 0.25em; color: var(--muted);
  }
  h1 { margin-top: 0.4rem; line-height: 1.05; font-weight: 900; color: #F0EBE0; }

  /* Bokhylle: smale rygger med loddrett tekst, den aktive eller den du peker på folder seg ut */
  .hylle { display: none; height: 12.5rem; margin-top: 2rem; border: 2px solid #F0EBE0; }
  @media (min-width: 768px) { .hylle { display: flex; } }
  .rygg {
    flex: 0 0 4rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem;
    background: #111; color: #C8BFB0; border: 0; border-right: 2px solid #F0EBE0; cursor: pointer;
    transition: flex 0.35s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s;
  }
  .rygg:last-child { border-right: 0; }
  .rygg-tekst {
    font-family: var(--font-overskrift); font-weight: 800; text-transform: uppercase;
    font-size: 1.125rem; letter-spacing: 0.15em; white-space: nowrap;
    writing-mode: vertical-rl; transform: rotate(180deg);
  }
  .rygg-antall { display: none; font-size: 1rem; color: #A9A9A9; }
  .rygg.aktiv, .rygg:hover, .rygg:focus-visible { flex: 1; background: #000; }
  .rygg.aktiv .rygg-tekst, .rygg:hover .rygg-tekst, .rygg:focus-visible .rygg-tekst {
    writing-mode: horizontal-tb; transform: none; font-size: 2.25rem; color: #F0EBE0;
  }
  .rygg.aktiv .rygg-antall, .rygg:hover .rygg-antall, .rygg:focus-visible .rygg-antall { display: block; }
  /* Når du peker på en annen rygg, folder den aktive seg sammen igjen */
  .hylle:hover .rygg.aktiv:not(:hover) { flex: 0 0 4rem; background: #1e1e1e; }
  .hylle:hover .rygg.aktiv:not(:hover) .rygg-tekst { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 1.125rem; }
  .hylle:hover .rygg.aktiv:not(:hover) .rygg-antall { display: none; }
  .rygg:focus-visible { outline: 3px solid var(--knapp); outline-offset: -5px; }
  @media (prefers-reduced-motion: reduce) { .rygg { transition: none; } }

  /* Knapper */
  .brikker { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  @media (min-width: 768px) { .brikker { display: none; } }
  .brikke {
    min-height: 44px; padding: 0.55rem 1rem 0.4rem; cursor: pointer;
    font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase; font-size: 1.125rem; letter-spacing: 0.1em;
    color: #F0EBE0; background: transparent; border: 2px solid #6b6b6b; border-radius: var(--knapp-hjorne);
  }
  .brikke:hover { border-color: #F0EBE0; }
  .brikke[aria-pressed='true'] { background: #F0EBE0; color: #000; border-color: #F0EBE0; }
  .brikke-antall { opacity: 0.7; margin-left: 0.25rem; }
  .brikke:focus-visible { outline: 3px solid var(--knapp); outline-offset: 2px; }


  .antall-vist { margin-top: 1rem; margin-bottom: 1rem; font-size: 1.125rem; color: #A9A9A9; }

  /* Bildene kant i kant, uten avrunding */
  .rutenett { columns: 2; column-gap: 4px; }
  @media (min-width: 768px) { .rutenett { columns: 3; } }
  @media (min-width: 1200px) { .rutenett { columns: 4; } }
  .bilde {
    display: block; width: 100%; margin: 0 0 4px; padding: 0; border: 0; background: #111;
    break-inside: avoid; overflow: hidden; cursor: zoom-in;
  }
  .bilde img { display: block; width: 100%; height: auto; transition: transform 0.5s; }
  .bilde:hover img { transform: scale(1.04); }
  .bilde:focus-visible { outline: 3px solid var(--knapp); outline-offset: -3px; }
  .bilde[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .bilde img { transition: none; } .bilde:hover img { transform: none; } }
</style>

<script>
  const knapper = document.querySelectorAll<HTMLButtonElement>('[data-filter]')
  const bilder = document.querySelectorAll<HTMLButtonElement>('.bilde')
  const status = document.querySelector('.antall-vist')!

  function velg(filter: string) {
    let vist = 0
    bilder.forEach((b) => {
      const synlig = filter === 'alle' || b.dataset.category === filter
      b.hidden = !synlig
      if (synlig) vist++
    })
    knapper.forEach((k) => {
      const valgt = k.dataset.filter === filter
      k.setAttribute('aria-pressed', String(valgt))
      k.classList.toggle('aktiv', valgt)
    })
    status.textContent = `Viser ${vist} ${vist === 1 ? 'bilde' : 'bilder'}`
  }

  knapper.forEach((k) => k.addEventListener('click', () => velg(k.dataset.filter!)))
  velg('alle')
</script>
