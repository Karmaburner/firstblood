---
import { u } from "../lib/url"
import Layout from '../layouts/Layout.astro'
---

<Layout title="Om" description="Trond Kjørkleiv driver First Blood Tattoo i Sandnes. Godt gammeldags håndverk av god kvalitet, ærlig kommunikasjon og lidenskap for kunsten.">
  <section class="om">
    <figure class="om-bilde">
      <img src={u("/images/trond.avif")} alt="Trond Kjørkleiv med solbriller og sigar" width="760" height="956" />
    </figure>

    <div class="om-tekst">
      <p class="etikett">First Blood · Sandnes · Siden 2007</p>
      <h1>Godt gammeldags håndverk.</h1>
      <p class="navn">Trond Kjørkleiv</p>

      <a class="vurdering" href="https://www.google.com/maps/search/?api=1&query=First+Blood+Tattoo+Sandnes" target="_blank" rel="noopener">
        <span class="stjerner" aria-hidden="true">★★★★★</span>
        <span>4,9 av 5 · 30 Google-anmeldelser</span>
      </a>

      <div class="brodtekst">
        <p>
          First Blood Tattoo er et tatoveringsstudio i Sandnes, drevet av Trond Kjørkleiv.
          Med mange år bak seg i bransjen har Trond bygget seg et solid rykte på godt håndverk,
          ærlig kommunikasjon og lidenskap for kunsten.
        </p>
        <p>
          Her handler det om gammeldags håndverk av god kvalitet og tradisjon.
          Ingen unødvendige tilbud og ingen kompromisser på arbeid. Bare tatoveringer
          laget med omhu og stolthet.
        </p>
      </div>

      <p class="slagord">Vi tatoverer. <span>Ingenting annet.</span></p>

      <div class="knapper">
        <a href={u("/kontakt")} class="knapp knapp-hoved">Ta kontakt</a>
        <a href={u("/galleri")} class="knapp knapp-kant">Se tatoveringer</a>
      </div>

      <section class="linework" aria-labelledby="linework-tittel">
        <p class="etikett">Sideprosjekt</p>
        <h2 id="linework-tittel">Linework by Trond</h2>
        <p>Utenfor studioet utforsker Trond håndtegnet kunst og linework, et kreativt sideprosjekt der pennen tar over fra nålen.</p>
        <a href="https://www.instagram.com/lineworkbytrond" target="_blank" rel="noopener" class="lenke">@lineworkbytrond på Instagram</a>
      </section>
    </div>
  </section>
</Layout>

<style>
  .om {
    display: grid; gap: 2.5rem;
    max-width: 72rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem;
  }
  @media (min-width: 900px) {
    .om { grid-template-columns: 0.9fr 1.1fr; gap: 4.5rem; padding: 4.5rem 2rem 5rem; align-items: start; }
    .om-bilde { position: sticky; top: 8.5rem; }
  }
  .om-bilde { margin: 0; }
  .om-bilde img { display: block; width: 100%; height: auto; }

  .etikett {
    font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
    font-size: 1.125rem; letter-spacing: 0.25em; color: var(--muted);
  }
  h1 { margin-top: 0.5rem; line-height: 0.95; font-weight: 900; color: #F0EBE0; }
  .navn {
    font-family: var(--font-overskrift); font-weight: 800; text-transform: uppercase;
    font-size: 1.75rem; letter-spacing: 0.06em; color: #C8BFB0; margin-top: 0.75rem;
  }

  .vurdering {
    display: inline-flex; align-items: center; gap: 0.75rem; margin-top: 1.5rem;
    font-size: 1.125rem; color: #F0EBE0; text-decoration: none;
    border-bottom: 1px solid #3a3a3a; padding-bottom: 0.25rem;
  }
  .vurdering:hover { border-color: #F0EBE0; }
  .stjerner { color: var(--knapp); letter-spacing: 0.1em; }

  .brodtekst { margin-top: 2rem; display: grid; gap: 1.25rem; max-width: 36rem; }
  .brodtekst p { font-size: 1.25rem; line-height: 1.6; color: #E4DED2; }

  .slagord {
    margin-top: 2.5rem; font-family: var(--font-overskrift); font-weight: 900; text-transform: uppercase;
    font-size: clamp(2rem, 4vw, 3rem); line-height: 1; color: #F0EBE0;
  }
  .slagord span { color: var(--accent); }

  .knapper { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .knapp {
    display: inline-flex; align-items: center; min-height: 3rem; padding: 0.7rem 1.6rem 0.5rem;
    font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
    font-size: 1.375rem; letter-spacing: 0.08em; line-height: 1; text-decoration: none; border-radius: var(--knapp-hjorne);
    transition: background-color 0.15s, color 0.15s;
  }
  .knapp-hoved { background: var(--knapp); color: var(--knapp-tekst); }
  .knapp-hoved:hover { background: var(--knapp-hover); }
  .knapp-kant { border: 2px solid #F0EBE0; color: #F0EBE0; }
  .knapp-kant:hover { background: #F0EBE0; color: #000; }
  .knapp:focus-visible, .lenke:focus-visible, .vurdering:focus-visible { outline: 3px solid #F0EBE0; outline-offset: 3px; }

  .linework { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #3a3a3a; max-width: 36rem; }
  .linework h2 { font-size: 2rem; color: #F0EBE0; margin-top: 0.4rem; }
  .linework p:not(.etikett) { font-size: 1.125rem; line-height: 1.6; color: #E4DED2; margin-top: 0.75rem; }
  .lenke { display: inline-block; margin-top: 1rem; font-size: 1.125rem; color: #F0EBE0; text-decoration: underline; text-underline-offset: 4px; }
</style>
