---
import Layout from '../layouts/Layout.astro'
import Kart from '../components/Kart.astro'

// Trond vil bli kontaktet på telefon, e-post og sosiale medier, ikke via skjema.
const epost = 'tattootrond@hotmail.com'
---

<Layout title="Kontakt" description="Ring 47 31 59 59, send e-post eller skriv på Facebook og Instagram for timebestilling og gratis konsultasjon hos First Blood Tattoo i Langgata 1B, Sandnes.">
  <div class="side-bakgrunn">
  <section class="kontakt">
    <header class="kontakt-topp">
      <p class="etikett">Kontakt</p>
      <h1>Gratis konsultasjon</h1>
      <p class="ingress">Ring, send e-post eller skriv på Facebook og Instagram for timebestilling og spørsmål. Ta kontakt, så finner vi det rette for deg.</p>
    </header>

    <div class="kontakt-rutenett">
      <div>
        <h2>Ta kontakt</h2>
        <ul class="info">
          <li>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 11 19.79 19.79 0 0 1 1.62 2.38a2 2 0 0 1 1.79-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9a16 16 0 0 0 6.29 6.29l.46-.46a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <div>
              <span class="info-navn">Telefon</span>
              <a href="tel:+4747315959" class="info-verdi stor">47 31 59 59</a>
            </div>
          </li>
          <li>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            <div>
              <span class="info-navn">E-post</span>
              <a href={`mailto:${epost}`} class="info-verdi epost">{epost}</a>
            </div>
          </li>
          <li>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            <div>
              <span class="info-navn">Facebook</span>
              <a href="https://www.facebook.com/firstbloodtattoo" target="_blank" rel="noopener" class="info-verdi">firstbloodtattoo</a>
            </div>
          </li>
          <li>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            <div>
              <span class="info-navn">Instagram</span>
              <a href="https://www.instagram.com/megatrond9/" target="_blank" rel="noopener" class="info-verdi">@megatrond9</a>
            </div>
          </li>
        </ul>
      </div>

      <div>
        <h2>Besøk studioet</h2>
        <ul class="info">
          <li>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <span class="info-navn">Adresse</span>
              <a href="https://www.google.com/maps/search/?api=1&query=Langgata+1B%2C+4306+Sandnes" target="_blank" rel="noopener" class="info-verdi">Langgata 1B, 4306 Sandnes</a>
            </div>
          </li>
          <li>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <div>
              <span class="info-navn">Åpningstider</span>
              <span class="info-verdi">Mandag–lørdag fra kl. 10:00, etter avtale</span>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <section class="finn-fram" aria-labelledby="finn-fram-tittel">
      <h2 id="finn-fram-tittel">Finn fram</h2>
      <p class="finn-fram-tekst">Studioet ligger i Langgata 1B, midt i Sandnes sentrum.</p>
      <Kart />
    </section>
  </section>
  </div>
</Layout>

<style>
  .kontakt { max-width: 68rem; margin: 0 auto; padding: 3rem 1.25rem 4rem; }
  @media (min-width: 768px) { .kontakt { padding: 4.5rem 2rem 5rem; } }

  .kontakt-topp { max-width: 40rem; margin-bottom: 3rem; }
  .etikett {
    font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
    font-size: 1.125rem; letter-spacing: 0.25em; color: var(--muted);
  }
  .kontakt-topp h1 { margin-top: 0.5rem; line-height: 1.05; font-weight: 900; color: #F0EBE0; }
  .ingress { font-size: 1.375rem; line-height: 1.5; color: #C8BFB0; margin-top: 1rem; }

  .kontakt-rutenett { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .kontakt-rutenett { grid-template-columns: 1fr 1fr; gap: 5rem; } }

  h2 { font-size: 1.75rem; color: #F0EBE0; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid #3a3a3a; }

  .info { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; }
  .info li { display: flex; gap: 1rem; align-items: flex-start; }
  .info svg { flex-shrink: 0; margin-top: 0.35rem; color: var(--ikon); }
  .info-navn {
    display: block; font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
    font-size: 1rem; letter-spacing: 0.15em; color: var(--muted);
  }
  .info-verdi { display: inline-block; font-size: 1.25rem; line-height: 1.3; color: #F0EBE0; }
  .info-verdi.stor { font-family: var(--font-overskrift); font-weight: 800; font-size: 2rem; letter-spacing: 0.04em; }
  .info-verdi.epost { overflow-wrap: anywhere; } /* lang adresse skal ikke gi sidelengs rulling på mobil */
  a.info-verdi { text-decoration: underline; text-decoration-color: rgba(240,235,224,0.35); text-underline-offset: 4px; }
  a.info-verdi:hover { text-decoration-color: #F0EBE0; }
  a.info-verdi:focus-visible { outline: 3px solid #F0EBE0; outline-offset: 3px; }

  .finn-fram { margin-top: 4rem; }
  .finn-fram-tekst { font-size: 1.25rem; color: #E4DED2; margin: -0.5rem 0 1.25rem; }
</style>
