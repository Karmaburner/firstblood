---
import { u } from "../lib/url"
import '../styles/global.css'
import Lightbox from '../components/Lightbox.astro'

interface Props {
  title?: string
  description?: string
}

const standardBeskrivelse = 'First Blood Tattoo er Trond Kjørkleivs tatoveringsstudio i Langgata 1B i Sandnes. Godt gammeldags håndverk av god kvalitet. Gratis konsultasjon.'
const { title = 'Forside', description = standardBeskrivelse } = Astro.props
const fullTittel = title === 'Forside' ? 'First Blood Tattoo · Tatoveringsstudio i Sandnes' : `${title} · First Blood Tattoo`
const kanonisk = new URL(Astro.url.pathname, Astro.site).href
const delingsbilde = new URL(u('/og.jpg'), Astro.site).href
const forside = new URL(u('/'), Astro.site).href

// Strukturert data: forteller søkemotorer at dette er et tatoveringsstudio.
// Åpningstider og vurderinger er utelatt til Trond har bekreftet dem.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TattooParlor',
  name: 'First Blood Tattoo',
  url: forside,
  image: delingsbilde,
  telephone: '+47 47 31 59 59',
  founder: { '@type': 'Person', name: 'Trond Kjørkleiv' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Langgata 1B',
    postalCode: '4306',
    addressLocality: 'Sandnes',
    addressCountry: 'NO',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 58.8507357, longitude: 5.7325826 },
  sameAs: ['https://www.facebook.com/firstbloodtattoo', 'https://www.instagram.com/megatrond9/'],
}
const nav = [
  { href: u('/'), label: 'Forside' },
  { href: u('/galleri'), label: 'Galleri' },
  { href: u('/om'), label: 'Om' },
  { href: u('/kontakt'), label: 'Kontakt' },
]
const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Demo: skjult for søkemotorer. Fjern denne linjen når Trond har godkjent siden. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{fullTittel}</title>
    <link rel="canonical" href={kanonisk} />
    <link rel="icon" href={u('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:site_name" content="First Blood Tattoo" />
    <meta property="og:title" content={fullTittel} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={kanonisk} />
    <meta property="og:image" content={delingsbilde} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="First Blood-logoen med hodeskalle ved siden av et portrett av Trond Kjørkleiv" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600..900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    /* Logo: hodeskallen og teksten side om side, så begge synes */
    #site-logo { display: inline-flex; align-items: center; gap: 0.6rem; }
    .logo-skalle { height: 3.75rem; width: auto; }
    .logo-tekst  { height: 1.9rem; width: auto; }
    @media (min-width: 768px) {
      #site-logo { gap: 0.9rem; }
      .logo-skalle { height: 5.25rem; }
      .logo-tekst  { height: 3.1rem; }
    }
    .meny-knapp {
      display: inline-flex; align-items: center; gap: 0.6rem;
      min-height: 44px; padding: 0.25rem 0.5rem;
      color: var(--text); background: none; border: 0; cursor: pointer;
      font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
      font-size: 1.125rem; letter-spacing: 0.15em; line-height: 1;
      opacity: 0.9; transition: opacity 0.2s;
    }
    .meny-knapp:hover { opacity: 1; }
    .meny-knapp:focus-visible, #site-logo:focus-visible, .header-kontakt:focus-visible { outline: 3px solid #F0EBE0; outline-offset: 3px; }
    .header-kontakt {
      display: none; align-items: center; min-height: 44px; padding: 0.55rem 1.4rem 0.4rem;
      font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase;
      font-size: 1.125rem; letter-spacing: 0.12em; line-height: 1;
      /* Omriss, så «Se tatoveringer» i heroen er det tydelige hovedvalget */
      background: transparent; color: var(--knapp); border: 2px solid var(--knapp);
      border-radius: var(--knapp-hjorne); transition: background-color 0.15s, color 0.15s;
    }
    .header-kontakt:hover { background: var(--knapp); color: var(--knapp-tekst); }
    .meny-lenke { display: none; }
    @media (min-width: 768px) {
      .header-kontakt, .meny-lenke { display: inline-flex; }
      #menu-btn { display: none; }
    }

    /* Bunntekst: tre kolonner som starter likt, og en egen linje nederst */
    .bunn { margin-top: 5rem; background: #0A0A0A; border-top: 1px solid #2a2a2a; color: #A9A39A; font-size: 1rem; line-height: 1.5; }
    .bunn-innhold {
      max-width: 72rem; margin: 0 auto; padding: 3rem 1.25rem 2rem;
      display: grid; gap: 2.5rem; align-items: start;
    }
    @media (min-width: 768px) { .bunn-innhold { grid-template-columns: repeat(3, 1fr); padding: 3.5rem 2rem 2.5rem; } }
    .bunn-kolonne { display: flex; flex-direction: column; gap: 0.4rem; }
    .bunn-tittel {
      font-family: var(--font-overskrift); font-weight: 800; text-transform: uppercase;
      font-size: 1.125rem; letter-spacing: 0.12em; color: #F0EBE0; margin-bottom: 0.4rem;
    }
    .bunn-lenke { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 28px; align-self: flex-start; color: #A9A39A; text-decoration: none; transition: color 0.15s; }
    .bunn-lenke svg { color: var(--ikon); flex-shrink: 0; }
    .bunn-lenke:hover { color: #F0EBE0; }
    .bunn a:focus-visible { outline: 3px solid #F0EBE0; outline-offset: 3px; }
    .bunn-linje {
      max-width: 72rem; margin: 0 auto; padding: 1.25rem 1.25rem 2rem;
      border-top: 1px solid #1f1f1f;
      display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem;
    }
    @media (min-width: 768px) { .bunn-linje { padding: 1.25rem 2rem 2rem; } }
    .bunn-linje a { color: #A9A39A; text-decoration: underline; text-underline-offset: 3px; }
    .bunn-linje a:hover { color: #F0EBE0; }
  </style>
  </head>
  <body class="flex flex-col min-h-screen">
    <header class="sticky top-0 z-50 border-b overflow-visible relative" style={`background-image: linear-gradient(to right, rgba(28,28,28,0.88) 0%, rgba(28,28,28,0.92) 10%, #000000 35%, #000000 60%, rgba(28,28,28,0.92) 90%, rgba(28,28,28,0.88) 100%), url('${u("/images/teppe.avif")}'); background-size: cover; background-position: center; border-color: var(--border);`}>
      <div class="px-4 md:px-8 h-20 md:h-[6.5rem] flex items-center justify-between gap-4">
        <a href={u("/")} id="site-logo" class="shrink-0">
          <img src={u("/images/logo-skalle.avif")} alt="" class="logo-skalle" width="215" height="240" />
          <img src={u("/images/logo-tekst.avif")} alt="First Blood, til forsiden" class="logo-tekst" width="409" height="160" />
        </a>
        <div class="flex items-center gap-3 md:gap-6">
          <a href={u("/kontakt")} class="header-kontakt">Kontakt</a>
          <a href={u("/meny")} class="meny-knapp meny-lenke">
            <svg width="36" height="36" viewBox="0 0 28 28" fill="currentColor" aria-hidden="true">
              <rect x="3" y="3" width="10" height="10" rx="2"/><rect x="15" y="3" width="10" height="10" rx="2"/>
              <rect x="3" y="15" width="10" height="10" rx="2"/><rect x="15" y="15" width="10" height="10" rx="2"/>
            </svg>
            Meny
          </a>
          <button id="menu-btn" type="button" class="meny-knapp" aria-expanded="false" aria-controls="mobile-menu">
            <svg width="26" height="26" viewBox="0 0 22 22" fill="currentColor" aria-hidden="true">
              <rect x="2" y="2" width="8" height="8" rx="1.5"/><rect x="12" y="2" width="8" height="8" rx="1.5"/>
              <rect x="2" y="12" width="8" height="8" rx="1.5"/><rect x="12" y="12" width="8" height="8" rx="1.5"/>
            </svg>
            Meny
          </button>
        </div>
      </div>
      <div id="mobile-menu" class="hidden md:hidden border-t" style="background-color: #0A0A0A; border-color: var(--border);">
        <ul class="flex flex-col px-6 py-4 gap-4" style="font-family: var(--font-overskrift); font-weight: 700; text-transform: uppercase; font-size: 1.3rem; letter-spacing: 0.12em; color: #e8f4f8;">
          {nav.map(({ href, label }) => (
            <li>
              <a href={href} class="hover:text-[#F0EBE0] transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <Lightbox />
    <div id="texture-overlay"></div>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bunn">
      <div class="bunn-innhold">
        <div class="bunn-kolonne">
          <h2 class="bunn-tittel">First Blood Tattoo</h2>
          <p>Trond Kjørkleiv</p>
          <p>Langgata 1B, 4306 Sandnes</p>
          <p>Org.nr. 811 872 792</p>
        </div>
        <div class="bunn-kolonne">
          <h2 class="bunn-tittel">Kontakt</h2>
          <a href="tel:+4747315959" class="bunn-lenke"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 11 19.79 19.79 0 0 1 1.62 2.38a2 2 0 0 1 1.79-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9a16 16 0 0 0 6.29 6.29l.46-.46a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>47 31 59 59</a>
          <a href="https://www.facebook.com/firstbloodtattoo" target="_blank" rel="noopener" class="bunn-lenke"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>Facebook</a>
          <a href="https://www.instagram.com/megatrond9/" target="_blank" rel="noopener" class="bunn-lenke"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>@megatrond9</a>
        </div>
        <nav class="bunn-kolonne" aria-label="Sider">
          <h2 class="bunn-tittel">Sider</h2>
          {nav.map(({ href, label }) => <a href={href} class="bunn-lenke">{label}</a>)}
        </nav>
      </div>
      <div class="bunn-linje">
        <p>© {new Date().getFullYear()} First Blood Tattoo</p>
        <p>Nettside av: <a href="https://lilitlabs.com" target="_blank" rel="noopener">Lilit Labs</a></p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn')
      const menu = document.getElementById('mobile-menu')
      btn?.addEventListener('click', () => {
        const aapen = menu?.classList.toggle('hidden') === false
        btn.setAttribute('aria-expanded', String(aapen))
      })
    </script>


  </body>
</html>
